# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# --- PostgreSQL (docker-compose reads these) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=papers
# Host port for Postgres. 5433 avoids clashing with any other local Postgres on 5432.
PG_PORT=5433

# Connection string used by the Next.js API and the Python ingestion scripts.
# Keep user, password, port and database in sync with the values above.
DATABASE_URL=postgresql://app:change-me@localhost:5433/papers

# --- Qdrant ---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# --- Web app sessions ---
# Long random string used to sign the session cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# --- First admin account (created by the admin seed script) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# --- OpenAlex (data ingestion) ---
# Free key from https://openalex.org (needed for paging past the first page of results).
OPENALEX_API_KEY=
# Your email, sent with requests so OpenAlex can contact you about heavy usage.
OPENALEX_EMAIL=
